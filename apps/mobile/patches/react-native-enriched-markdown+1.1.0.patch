@@ -0,0 +1,68 @@
+package com.swmansion.enriched.markdown.spans
+
+import android.content.res.Resources
+import android.text.Spanned
+import android.text.TextPaint
+import android.text.style.MetricAffectingSpan
+
+/**
+ * Litch patch: the character placed at both ends of inline code. It is squeezed to [CODE_PAD_DP]
+ * of width and draws nothing, so the code background has room on the left and right (a
+ * LineBackgroundSpan can't change the layout). U+202F NARROW NO-BREAK SPACE glues the pad to the
+ * code, so a line never breaks between them (a ReplacementSpan would allow that break). Copy, the
+ * selection menu, Markdown and HTML conversion skip the characters CodePaddingSpan covers (by
+ * position, so a U+202F that is part of the text stays): see [textWithoutCodePads], [isCodePad].
+ */
+const val CODE_PAD = '\u202F'
+
+/** Width of each pad in dp: the gap outside the box plus the padding inside it */
+const val CODE_PAD_DP = 5f
+
+/** Gap between the box and the text next to it, in dp (the rest of the pad is padding) */
+const val CODE_MARGIN_DP = 1f
+
+/** Padding above and below the code glyphs, in dp */
+const val CODE_PAD_Y_DP = 1f
+
+/** Corner radius of the box, in dp */
+const val CODE_RADIUS_DP = 4f
+
+fun dp(value: Float): Float = value * Resources.getSystem().displayMetrics.density
+
+/** [start, end) is a code pad and nothing else */
+fun Spanned.isCodePad(
+  start: Int,
+  end: Int,
+): Boolean =
+  end > start &&
+    getSpans(start, end, CodePaddingSpan::class.java).any { getSpanStart(it) <= start && getSpanEnd(it) >= end }
+
+/** The text of [start, end) without the code pads */
+fun CharSequence.textWithoutCodePads(
+  start: Int,
+  end: Int,
+): String {
+  val spanned = this as? Spanned ?: return subSequence(start, end).toString()
+  val pads = spanned.getSpans(start, end, CodePaddingSpan::class.java)
+  if (pads.isEmpty()) return subSequence(start, end).toString()
+  val skip = BooleanArray(end - start)
+  for (pad in pads) {
+    for (at in maxOf(start, spanned.getSpanStart(pad)) until minOf(end, spanned.getSpanEnd(pad))) skip[at - start] = true
+  }
+  val out = StringBuilder(end - start)
+  for (at in start until end) if (!skip[at - start]) out.append(this[at])
+  return out.toString()
+}
+
+/** Set after CodeSpan, so the code font is already on the paint when the pad is squeezed */
+class CodePaddingSpan : MetricAffectingSpan() {
+  override fun updateMeasureState(tp: TextPaint) = squeeze(tp)
+
+  override fun updateDrawState(tp: TextPaint) = squeeze(tp)
+
+  private fun squeeze(paint: TextPaint) {
+    paint.textScaleX = 1f
+    val natural = paint.measureText(CODE_PAD.toString())
+    if (natural > 0f) paint.textScaleX = dp(CODE_PAD_DP) / natural
+  }
+}

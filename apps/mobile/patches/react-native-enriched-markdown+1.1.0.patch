+package com.swmansion.enriched.markdown.segments
+
+import android.content.Context
+import android.view.MotionEvent
+import android.view.ViewConfiguration
+import android.widget.HorizontalScrollView
+import com.facebook.react.uimanager.events.NativeGestureUtil
+import kotlin.math.abs
+
+/**
+ * Litch patch: the horizontal scroller of tables and code blocks inside a vertical list. A vertical
+ * ScrollView takes the gesture as soon as the finger has moved a touch slop vertically, whatever
+ * the horizontal movement, so a sideways swipe that drifts a little up or down scrolled the list
+ * instead of the table. While there is something to scroll sideways, keep the parents from
+ * intercepting until the direction is known: mostly vertical hands the gesture back to them,
+ * mostly horizontal keeps it here and cancels the JS touch (a Pressable's long press around it).
+ */
+class NestedHorizontalScrollView(
+  context: Context,
+) : HorizontalScrollView(context) {
+  private val touchSlop = ViewConfiguration.get(context).scaledTouchSlop
+  private var downX = 0f
+  private var downY = 0f
+  private var deciding = false
+
+  /** This gesture went vertical: leave it to the parents, don't start a sideways drag in it */
+  private var vertical = false
+
+  override fun dispatchTouchEvent(ev: MotionEvent): Boolean {
+    when (ev.actionMasked) {
+      MotionEvent.ACTION_DOWN -> {
+        downX = ev.x
+        downY = ev.y
+        vertical = false
+        deciding = canScrollHorizontally(1) || canScrollHorizontally(-1)
+        if (deciding) parent?.requestDisallowInterceptTouchEvent(true)
+      }
+
+      MotionEvent.ACTION_MOVE -> {
+        if (deciding) {
+          val dx = abs(ev.x - downX)
+          val dy = abs(ev.y - downY)
+          if (dx > touchSlop || dy > touchSlop) {
+            deciding = false
+            if (dy > dx) {
+              vertical = true
+              parent?.requestDisallowInterceptTouchEvent(false)
+              // The parent only takes over at the next move; cancel the cells now, so their long
+              // press (the table's copy menu) doesn't fire in between, as it couldn't before
+              val cancel = MotionEvent.obtain(ev).apply { action = MotionEvent.ACTION_CANCEL }
+              super.dispatchTouchEvent(cancel)
+              cancel.recycle()
+              return true
+            } else {
+              NativeGestureUtil.notifyNativeGestureStarted(this, ev)
+            }
+          }
+        }
+      }
+
+      MotionEvent.ACTION_UP, MotionEvent.ACTION_CANCEL -> deciding = false
+    }
+    return super.dispatchTouchEvent(ev)
+  }
+
+  override fun onInterceptTouchEvent(ev: MotionEvent): Boolean = !vertical && super.onInterceptTouchEvent(ev)
+
+  override fun onTouchEvent(ev: MotionEvent): Boolean = if (vertical) true else super.onTouchEvent(ev)
+}

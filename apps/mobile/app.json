{
  "expo": {
    "name": "Litch Proto",
    "slug": "litch-mobile-proto",
    "version": "0.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "litchproto",
    "android": {
      "package": "dev.litch.mobileproto"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "usesCleartextTraffic": true,
            "buildArchs": [
              "arm64-v8a"
            ]
          }
        }
      ]
    ]
  }
}

{
  "expo": {
    "name": "Litch",
    "slug": "litch",
    "version": "0.42.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "scheme": "litch",
    "android": {
      "package": "dev.litch.app",
      "permissions": ["android.permission.REQUEST_INSTALL_PACKAGES"],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      }
    },
    "plugins": [
      "./plugins/release-signing",
      "./plugins/ios-release-signing",
      [
        "expo-camera",
        {
          "cameraPermission": "Litch uses the camera to scan the pairing QR code shown on your computer.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Litch uses Face ID to confirm sign-in approvals for your computer."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "usesCleartextTraffic": true,
            "buildArchs": ["arm64-v8a"]
          }
        }
      ]
    ],
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "dev.litch.app",
      "supportsTablet": true,
      "entitlements": {
        "keychain-access-groups": ["$(AppIdentifierPrefix)$(PRODUCT_BUNDLE_IDENTIFIER)"]
      },
      "infoPlist": {
        "UISupportedInterfaceOrientations": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ],
        "UISupportedInterfaceOrientations~ipad": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ],
        "NSLocalNetworkUsageDescription": "Litch connects to your computers over SSH on your local network.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "locales": {
      "en": "./locales/ios-en.json",
      "zh-Hans": "./locales/ios-zh-Hans.json"
    }
  }
}

{
  "expo": {
    "name": "Litch",
    "slug": "litch",
    "version": "0.27.1",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "litch",
    "android": {
      "package": "dev.litch.app",
      "permissions": ["android.permission.REQUEST_INSTALL_PACKAGES"],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      }
    },
    "plugins": [
      "./plugins/release-signing",
      [
        "expo-camera",
        {
          "cameraPermission": "Litch uses the camera to scan the pairing QR code shown on your computer.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Litch uses Face ID to confirm sign-in approvals for your computer."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "usesCleartextTraffic": true,
            "buildArchs": ["arm64-v8a"]
          }
        }
      ]
    ],
    "icon": "./assets/icon.png"
  }
}

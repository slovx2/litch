        "where": ["response thread/fork /", "response thread/start /"]
      },
      {
        "problem": ["多出字段 itemsBackwardsCursor", "多出字段 turnsBackwardsCursor"],
        "reason": "thread/rollback 上游已经删了，结构按 protocol/extensions/thread-rollback.json（照它被删之前的样子）；应答里多带了 thread/revert 才有的两个游标。",
        "where": ["response thread/rollback /"]
      },
      {
        "problem": "多出字段 threadId",
        "reason": "thread/started 的参数顶层多带了一份会话标识；上游只有 thread。",
        "where": ["notification thread/started /"]
      },
      {
        "problem": "多出字段 startedAtMs",
        "reason": "item/completed 多带了条目开始的时间；上游只有 item/started 带 startedAtMs，item/completed 带的是 completedAtMs。",
        "where": ["notification item/completed /"]
      },
      {
        "problem": ["多出字段 thread", "多出字段 sandbox", "多出字段 reasoningEffort"],
        "reason": "thread/settings/updated 的 threadSettings 里多了自己的字段；上游的 ThreadSettings 里对应的是 effort、sandboxPolicy、activePermissionProfile，不含会话对象。",
        "where": ["notification thread/settings/updated /threadSettings"]
      },
      {
        "problem": "多出字段 severity",
        "reason": "Pi 的扩展界面发来的提示转成 warning 通知时带了级别；上游的 warning 没有这个字段。",
        "where": ["notification warning /"]
      },
      {
        "problem": "多出字段 backwardsCursor",
        "reason": "共用的分页函数一律带回往前翻的游标；上游这几个列表的应答里没有这个字段。",
        "where": [
          "response thread/attachment/list /",
          "response thread/queue/list /",
          "response threadSection/list /"

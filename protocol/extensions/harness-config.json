    {
      "kind": "ClientRequest",
      "method": "litch/harness/models/write",
      "description": "整份写入模型清单。entries 为 null 是不用自定义清单、回到 harness 自己的模型目录；空数组、id 为空或重复、base 不在 bases 里、contextWindow 不是正整数回 invalidValue（key 指明哪一项，如 entries[1].base）。expectedVersion 对不上回 versionConflict，被管理员锁住回 readOnly。",
      "params": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "harness": {
            "type": "string"
          },
          "entries": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/HarnessModelEntry"
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "expectedVersion": {
            "type": "string"
          }
        },
        "required": ["harness", "entries", "expectedVersion"]
      },
      "response": {
        "$ref": "#/definitions/HarnessModelsWriteResponse"
      }
    },
    {
      "kind": "ClientRequest",
      "method": "litch/device/instructions/unify",
      "description": "统一模式：content 写进 sourcePath（真文件），linkPaths 里每个已有的文件（不是已经指向 sourcePath 的软链）先备份再换成指向 sourcePath 的软链；父目录不存在的跳过；建软链失败的写副本。路径都要是绝对路径、文件名是 AGENTS.md 或 CLAUDE.md，不是的回 invalidValue。",
      "params": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sourcePath": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "linkPaths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": ["sourcePath", "content", "linkPaths"]
      },
      "response": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/DeviceInstructionsLinkResult"
            }
          }
        },
        "required": ["results"]
      }
    },
    {
      "kind": "ClientRequest",
      "method": "litch/device/instructions/separate",
      "description": "退出统一模式：linkPaths 里指向 sourcePath 的软链换成 sourcePath 当前内容的副本，别的不动。",
      "params": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sourcePath": {
            "type": "string"
          },
          "linkPaths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": ["sourcePath", "linkPaths"]
      },
      "response": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "separated": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": ["separated"]
      }
    },
    {
      "kind": "ServerNotification",
      "method": "litch/harness/config/changed",
      "description": "某个 harness 的配置、provider、MCP、指令文件或模型清单经这套接口被改了，别的连接该重读。发给所有声明了 harnessConfig 的连接，发起改动的那条也收。不保证覆盖命令行或手改文件的改动。",
      "params": {
        "$ref": "#/definitions/HarnessConfigChangedNotification"
      }
    },
    {
      "kind": "ServerNotification",
      "method": "litch/harness/auth/updated",
      "description": "一次登录（auth/start 或 mcp/login 开的）有了新进展。只发给发起它的那条连接，而且要它声明了 harnessConfig。",
      "params": {
        "$ref": "#/definitions/HarnessAuthUpdatedNotification"
      }
    },
    {
      "kind": "Error",
      "description": "这个扩展自己回的错误：JSON-RPC 的 code 一律是 -32000，原因在 error.data.litch，给人看的两种语言在 error.data.message。harness 参数指的 harness 不在这台设备上时回 harness 扩展的 unknownHarness。上游 harness 自己回的别的错误原样带回。",
      "data": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "litch": {
            "enum": [
              "versionConflict",
              "readOnly",
              "invalidValue",
              "notFound",
              "authFailed",
              "unavailable"
            ]
          },
          "harness": {
            "type": "string"
          },
          "key": {
            "type": "string"
          },
          "message": {
            "$ref": "#/definitions/HarnessText"
          }
        },
        "required": ["litch", "harness"]
      },
      "errors": [
        {
          "litch": "versionConflict",
          "code": -32000,
          "description": "expectedVersion / expectedHash 对不上：重读再改"
        },
        {
          "litch": "readOnly",
          "code": -32000,
          "description": "这一项被更高一层（管理员、requirements）锁住了，或者 harness 不允许写（data.key 是哪一项）"
        },
        {
          "litch": "invalidValue",
          "code": -32000,
          "description": "值或参数不合法（data.key 是哪一项）"
        },
        {
          "litch": "notFound",
          "code": -32000,
          "description": "没有这个键、provider、MCP 服务、动作或登录"
        },
        {
          "litch": "authFailed",
          "code": -32000,
          "description": "登录失败、被取消、超时"
        },
        {
          "litch": "unavailable",
          "code": -32000,
          "description": "这个 harness 没装、没在跑，或者没连上，读不了它的配置"
        }
      ]
    }
  ],

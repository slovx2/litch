      },
      "required": ["path", "fileName", "exists", "content", "hash", "linkTarget", "overriddenBy"]
    },
    "DeviceInstructionsLinkResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string"
        },
        "outcome": {
          "enum": ["linked", "copied", "skipped"]
        },
        "backup": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["path", "outcome", "backup"]
    },
    "HarnessConfigChangedNotification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "harness": {
          "type": "string"
        },
        "part": {
          "enum": ["config", "providers", "mcp", "instructions", "models"]
        }
      },
      "required": ["harness", "part"]
    },
    "HarnessAuthUpdatedNotification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "harness": {
          "type": "string"
        },
        "attemptId": {
          "type": "string"
        },
        "providerId": {
          "type": "string"
        },
        "mcpServer": {
          "type": "string"
        },
        "step": {
          "$ref": "#/definitions/HarnessAuthStep"
        }
      },
      "required": ["harness", "attemptId", "step"]
    },
    "HarnessModelEntry": {
      "type": "object",
      "additionalProperties": false,
      "description": "模型清单里的一项",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "发给模型服务的模型名（codex 的 slug），清单里唯一"
        },
        "displayName": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "contextWindow": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "base": {
          "type": "string",
          "description": "照着哪个模型的其余设置（bases 里的 id）；和 id 相同表示原样用那个模型"
        }
      },
      "required": ["id", "displayName", "contextWindow", "base"]
    },
    "HarnessModelBase": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "displayName": {
          "type": "string"
        },
        "contextWindow": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["id", "displayName", "contextWindow", "description"]
    },
    "HarnessModelsReadResponse": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "custom": {
          "type": "boolean",
          "description": "在用自定义清单；false 时 harness 用它自己的模型目录，entries 是空的"
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/HarnessModelEntry"
          }
        },
        "bases": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/HarnessModelBase"
          },
          "description": "可以照着的模型，顺序就是显示的顺序"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "version": {
          "type": "string"
        },
        "effect": {
          "$ref": "#/definitions/HarnessSettingEffect"
        },
        "note": {
          "anyOf": [
            {
              "$ref": "#/definitions/HarnessText"
            },
            {
              "type": "null"
            }
          ]
        },
        "readOnlyReason": {
          "anyOf": [
            {
              "$ref": "#/definitions/HarnessText"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "custom",
        "entries",
        "bases",
        "path",
        "version",
        "effect",
        "note",
        "readOnlyReason"
      ]
    },
    "HarnessModelsWriteResponse": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "string"
        },
        "restartRequired": {
          "type": "boolean"
        }
      },
      "required": ["version", "restartRequired"]
    },
    "HarnessProvidersDiscoverModelsResponse": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "models": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": ["string", "null"]
              }
            },
            "required": ["id", "title"]
          }
        }
      },
      "required": ["models"]
    }
  }
}

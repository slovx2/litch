    },
    {
      "kind": "ClientRequest",
      "method": "litch/harness/auth/start",
      "description": "开始一次登录或设置 API key。应答是第一步，之后的进展经 auth/updated 通知给发起它的连接。env 方式不经这里（客户端直接写设备设置的 harness.<id>.env），调了回 invalidValue。",
      "params": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "harness": {
            "type": "string"
          },
          "providerId": {
            "type": "string"
          },
          "methodId": {
            "type": "string"
          },
          "inputs": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "required": ["harness", "providerId", "methodId"]
      },
      "response": {
        "$ref": "#/definitions/HarnessAuthStartResponse"
      }
    },
    {
      "kind": "ClientRequest",
      "method": "litch/harness/auth/continue",
      "description": "交上一步 prompt 要的东西（粘贴的授权码、表单）。应答是下一步。没有这次登录回 notFound；这一步不要输入回 invalidValue。",
      "params": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "harness": {
            "type": "string"
          },
          "attemptId": {
            "type": "string"
          },
          "inputs": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "required": ["harness", "attemptId", "inputs"]
      },
      "response": {
        "$ref": "#/definitions/HarnessAuthStartResponse"
      }
    },
    {
      "kind": "ClientRequest",
      "method": "litch/harness/auth/cancel",
      "description": "取消进行中的登录。没有这次登录回 notFound。",
      "params": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "harness": {
            "type": "string"
          },
          "attemptId": {
            "type": "string"
          }
        },
        "required": ["harness", "attemptId"]
      },
      "response": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}

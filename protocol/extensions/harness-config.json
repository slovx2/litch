      "params": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "harness": {
            "type": "string"
          },
          "providerId": {
            "type": "string"
          },
          "expectedVersion": {
            "type": "string"
          }
        },
        "required": ["harness", "providerId", "expectedVersion"]
      },
      "response": {
        "$ref": "#/definitions/HarnessProvidersWriteResponse"
      }
    },
    {

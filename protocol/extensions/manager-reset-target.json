{
  "extension": "litchManagerResetTarget",
  "description": "经理接班目标预检、设置确认与幂等换线程；须同时声明 litchManager。",
  "declaration": {
    "where": "initialize.params.capabilities.litchExtensions",
    "schema": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "contains": {
        "const": "litchManagerResetTarget"
      }
    }
  },
  "undeclared": "不接受 reset 的 target、expectedThreadId、expectedSettingsHash、requestId；不提供 preview；Manager.reset 不带 operation。无 target 的 reset 保持原行为。",
  "invariants": [
    "target 存在时 expectedThreadId、expectedSettingsHash、requestId 必填。哈希涵盖源实际设置与目标解析结果、能力、工具开关和派活设置。",
    "requestId 同计划返回同一操作，不同计划冲突；boardOnly 只重试原 summaryFailed 操作。",
    "设备、工作目录和有效权限固定；跨 harness 或型号/强度变化强制 replace。提交后只向前恢复，接班投递状态独立于绑定状态。",
    "旧连接收到普通 Manager 更新；operation 按接收连接声明过滤。"
  ],
  "fields": [
    {
      "target": "Manager.reset",
      "name": "operation",
      "schema": {
        "$ref": "#/definitions/Operation"
      }
    }
  ],

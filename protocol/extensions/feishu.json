{
  "extension": "litchFeishu",
  "description": "设备接的飞书应用（自建应用的机器人）：凭据、长连接状态、能力自检、分配的经理。",
  "appliesTo": "设备聚合面。设备通过 runtime/info.device.extensions 声明；客户端按连接在 initialize 中声明。",
  "declaration": {
    "where": "initialize.params.capabilities.litchExtensions",
    "schema": {
      "type": "array",
      "items": { "type": "string" },
      "contains": { "const": "litchFeishu" }
    }
  },
  "undeclared": "不提供飞书方法及通知。",
  "rules": [
    "写操作（创建向导、手动填写、换 App Secret、改分配、移除、补申请）只给设备管理员连接；读方法给声明了扩展的连接。",
    "App Secret 只在 configure、rotate 的参数里进来，任何结果、通知、诊断都不回显；飞书的访问令牌不出设备。",
    "只做国内飞书；创建向导返回 Lark 租户时拒绝。",
    "一个应用只分配给一个经理，一个经理也最多分配一个应用。",
    "时间用 UTC epoch 秒；飞书 ID 原样用字符串。",
    "群只有经 chat/access 明确接入后才收、记、发；机器人只是被拉进群什么都不做。接入必须选发言模式，外部群必须带 confirmExternal: true。",
    "机器人被移出已接入的群时接入设置保留（botPresent=false），重新拉进来自动恢复。",
    "设备只记录已接入群里的消息；接入时补最近 7 天、单次补历史最多 1000 条，进度在群的 records 里。",
    "收件箱只列 @ 了机器人或回复机器人、且发送人在叫醒名单里的消息；条目不带正文，inbox/get 从设备的消息库读原文。",
    "发言经发件队列：自由发言的群直接排队发出；审批发言的群先冻结内容、建 litchReviews 审批，批准后按冻结的内容原样发出。outbox/cancel 只撤还没发出的，不撤回飞书上已发的消息。",
    "私聊只和已绑定用户：没绑定的人私聊机器人时设备只回配对码（不记正文），设备管理员用 binding/lookup、binding/approve 按配对码确认；撤销后对方私聊和没绑定一样。标了 approver 的已绑定用户能在飞书的审批卡片上批审批。"
  ],
  "parts": [
    {
      "kind": "Method",
      "name": "litch/feishu/app/list",
      "params": { "type": "object", "additionalProperties": false, "properties": {} },
      "result": {
        "type": "object",
        "additionalProperties": false,
        "required": ["apps"],
        "properties": {
          "apps": { "type": "array", "items": { "$ref": "#/definitions/App" } },
          "admin": { "type": "boolean" }
        }
      }
    },
    {
      "kind": "Method",
      "name": "litch/feishu/app/get",
      "params": {
        "type": "object",
        "additionalProperties": false,
        "required": ["appId"],
        "properties": { "appId": { "$ref": "#/definitions/AppId" } }
      },
      "result": { "$ref": "#/definitions/AppResult" }
    },
    {
      "kind": "Method",
      "name": "litch/feishu/app/register/begin",
      "params": {
        "type": "object",
        "additionalProperties": false,
        "required": ["operationId", "name"],
        "properties": {
          "operationId": { "$ref": "#/definitions/OperationId" },
          "name": { "type": "string", "minLength": 1, "maxLength": 30 }
        }
      },
      "result": { "$ref": "#/definitions/RegistrationResult" }
    },
    {
      "kind": "Method",
      "name": "litch/feishu/app/register/get",
      "params": { "$ref": "#/definitions/RegistrationRef" },
      "result": { "$ref": "#/definitions/RegistrationResult" }
    },
    {
      "kind": "Method",
      "name": "litch/feishu/app/register/cancel",
      "params": { "$ref": "#/definitions/RegistrationRef" },
      "result": { "$ref": "#/definitions/RegistrationResult" }
    },
    {
      "kind": "Method",
      "name": "litch/feishu/app/configure",
      "params": {
        "type": "object",
        "additionalProperties": false,
        "required": ["operationId", "appId", "appSecret"],
        "properties": {
          "operationId": { "$ref": "#/definitions/OperationId" },
          "appId": { "$ref": "#/definitions/AppId" },
          "appSecret": { "type": "string", "minLength": 1, "maxLength": 256 }
        }
      },
      "result": { "$ref": "#/definitions/AppResult" }
    },
    {
      "kind": "Method",
      "name": "litch/feishu/app/rotate",
      "params": {
        "type": "object",
        "additionalProperties": false,
        "required": ["operationId", "appId", "appSecret", "expectedGeneration"],
        "properties": {
          "operationId": { "$ref": "#/definitions/OperationId" },
          "appId": { "$ref": "#/definitions/AppId" },
          "appSecret": { "type": "string", "minLength": 1, "maxLength": 256 },
          "expectedGeneration": { "$ref": "#/definitions/Revision" }
        }
      },
      "result": { "$ref": "#/definitions/AppResult" }
    },
    {
      "kind": "Method",
      "name": "litch/feishu/app/update",
      "params": {
        "type": "object",
        "additionalProperties": false,
        "required": ["appId", "expectedRevision"],
        "properties": {
          "appId": { "$ref": "#/definitions/AppId" },
          "expectedRevision": { "$ref": "#/definitions/Revision" },
          "managerId": { "oneOf": [{ "$ref": "#/definitions/LogicalId" }, { "type": "null" }] },
          "enabled": { "type": "boolean" }
        }
      },
      "result": { "$ref": "#/definitions/AppResult" }
    },
    {
      "kind": "Method",
      "name": "litch/feishu/app/remove",
      "params": {
        "type": "object",
        "additionalProperties": false,
        "required": ["appId", "expectedRevision"],
        "properties": {
          "appId": { "$ref": "#/definitions/AppId" },
          "expectedRevision": { "$ref": "#/definitions/Revision" }
        }
      },
      "result": { "type": "object", "additionalProperties": false, "properties": {} }
    },
    {
      "kind": "Method",
      "name": "litch/feishu/app/check",
      "params": {
        "type": "object",
        "additionalProperties": false,
        "required": ["appId"],
        "properties": { "appId": { "$ref": "#/definitions/AppId" } }
      },
      "result": { "$ref": "#/definitions/AppResult" }
    },
    {
      "kind": "Method",
      "name": "litch/feishu/app/upgrade",
      "params": {
        "type": "object",
        "additionalProperties": false,
        "required": ["appId", "operationId"],
        "properties": {
          "appId": { "$ref": "#/definitions/AppId" },
          "operationId": { "$ref": "#/definitions/OperationId" }
        }
      },
      "result": { "$ref": "#/definitions/AppResult" }
    },
    {
      "kind": "Method",
      "name": "litch/feishu/chat/list",
      "params": {
        "type": "object",
        "additionalProperties": false,
        "required": ["appId"],
        "properties": {
          "appId": { "$ref": "#/definitions/AppId" },
          "refresh": { "type": "boolean" }
        }
      },
      "result": {
        "type": "object",
        "additionalProperties": false,
        "required": ["chats", "syncedAt"],
        "properties": {
          "chats": { "type": "array", "items": { "$ref": "#/definitions/Chat" } },
          "syncedAt": { "oneOf": [{ "$ref": "#/definitions/Timestamp" }, { "type": "null" }] }
        }
      }
    },
    {
      "kind": "Method",
      "name": "litch/feishu/chat/get",
      "params": { "$ref": "#/definitions/ChatRef" },
      "result": { "$ref": "#/definitions/ChatResult" }
    },
    {
      "kind": "Method",
      "name": "litch/feishu/chat/members",
      "params": {
        "type": "object",
        "additionalProperties": false,
        "required": ["appId", "chatId"],
        "properties": {
          "appId": { "$ref": "#/definitions/AppId" },
          "chatId": { "$ref": "#/definitions/ChatId" },
          "refresh": { "type": "boolean" }
        }
      },
      "result": {
        "type": "object",
        "additionalProperties": false,
        "required": ["members", "fetchedAt"],
        "properties": {
          "members": { "type": "array", "items": { "$ref": "#/definitions/Member" } },
          "fetchedAt": { "$ref": "#/definitions/Timestamp" }
        }
      }
    },
    {
      "kind": "Method",
      "name": "litch/feishu/chat/access",
      "params": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "appId",
          "chatId",
          "expectedRevision",
          "speech",
          "wakeBound",
          "wakers",
          "retentionDays",
          "reviewTtlHours"
        ],
        "properties": {
          "appId": { "$ref": "#/definitions/AppId" },
          "chatId": { "$ref": "#/definitions/ChatId" },
          "expectedRevision": { "$ref": "#/definitions/Revision" },
          "speech": { "$ref": "#/definitions/SpeechMode" },
          "confirmExternal": { "type": "boolean" },
          "wakeBound": { "type": "boolean" },
          "wakers": { "$ref": "#/definitions/Wakers" },
          "retentionDays": { "$ref": "#/definitions/RetentionDays" },
          "reviewTtlHours": { "$ref": "#/definitions/ReviewTtlHours" }
        }
      },
      "result": { "$ref": "#/definitions/ChatResult" }
    },
    {
      "kind": "Method",
      "name": "litch/feishu/chat/update",
      "params": {
        "type": "object",
        "additionalProperties": false,
        "required": ["appId", "chatId", "expectedRevision"],
        "properties": {
          "appId": { "$ref": "#/definitions/AppId" },
          "chatId": { "$ref": "#/definitions/ChatId" },
          "expectedRevision": { "$ref": "#/definitions/Revision" },
          "speech": { "$ref": "#/definitions/SpeechMode" },
          "wakeBound": { "type": "boolean" },
          "wakers": { "$ref": "#/definitions/Wakers" },
          "retentionDays": { "$ref": "#/definitions/RetentionDays" },
          "reviewTtlHours": { "$ref": "#/definitions/ReviewTtlHours" }
        }
      },
      "result": { "$ref": "#/definitions/ChatResult" }
    },
    {
      "kind": "Method",
      "name": "litch/feishu/chat/unaccess",
      "params": {
        "type": "object",
        "additionalProperties": false,
        "required": ["appId", "chatId", "expectedRevision", "deleteRecords"],
        "properties": {
          "appId": { "$ref": "#/definitions/AppId" },
          "chatId": { "$ref": "#/definitions/ChatId" },
          "expectedRevision": { "$ref": "#/definitions/Revision" },
          "deleteRecords": { "type": "boolean" }
        }
      },
      "result": { "$ref": "#/definitions/ChatResult" }
    },
    {
      "kind": "Method",
      "name": "litch/feishu/chat/backfill",
      "params": {
        "type": "object",
        "additionalProperties": false,
        "required": ["appId", "chatId", "start", "end"],
        "properties": {
          "appId": { "$ref": "#/definitions/AppId" },
          "chatId": { "$ref": "#/definitions/ChatId" },
          "start": { "$ref": "#/definitions/Timestamp" },
          "end": { "$ref": "#/definitions/Timestamp" }
        }
      },
      "result": { "$ref": "#/definitions/ChatResult" }
    },
    {
      "kind": "Method",
      "name": "litch/feishu/inbox/list",
      "params": {
        "type": "object",
        "additionalProperties": false,
        "required": ["managerId"],
        "properties": {
          "managerId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$" },
          "statuses": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "uniqueItems": true,
            "items": { "$ref": "#/definitions/InboxStatus" }
          },
          "before": { "$ref": "#/definitions/InboxId" },
          "limit": { "type": "integer", "minimum": 1, "maximum": 200 }
        }
      },
      "result": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entries", "messages"],
        "properties": {
          "entries": { "type": "array", "items": { "$ref": "#/definitions/InboxEntry" } },
          "messages": {
            "description": "按 inboxId 给出对应消息；消息库里没有的不出现",
            "type": "object",
            "additionalProperties": { "$ref": "#/definitions/InboxMessage" }
          },
          "next": { "$ref": "#/definitions/InboxId" }
        }
      }
    },
    {
      "kind": "Method",
      "name": "litch/feishu/inbox/get",
      "params": {
        "type": "object",
        "additionalProperties": false,
        "required": ["inboxId"],
        "properties": { "inboxId": { "$ref": "#/definitions/InboxId" } }
      },
      "result": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entry", "message"],
        "properties": {
          "entry": { "$ref": "#/definitions/InboxEntry" },
          "message": {
            "oneOf": [{ "$ref": "#/definitions/InboxMessage" }, { "type": "null" }]
          }
        }
      }
    },
    {
      "kind": "Method",
      "name": "litch/feishu/outbox/list",
      "params": {
        "type": "object",
        "additionalProperties": false,
        "required": ["appId"],
        "properties": {
          "appId": { "$ref": "#/definitions/AppId" },
          "states": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "uniqueItems": true,
            "items": { "$ref": "#/definitions/OutboxState" }
          },
          "before": { "$ref": "#/definitions/OutboxOperationId" },
          "limit": { "type": "integer", "minimum": 1, "maximum": 200 }
        }
      },
      "result": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entries"],
        "properties": {
          "entries": { "type": "array", "items": { "$ref": "#/definitions/OutboxEntry" } },
          "next": { "$ref": "#/definitions/OutboxOperationId" }
        }
      }
    },
    {
      "kind": "Method",
      "name": "litch/feishu/outbox/cancel",
      "params": {
        "type": "object",
        "additionalProperties": false,
        "required": ["appId", "operationId"],
        "properties": {
          "appId": { "$ref": "#/definitions/AppId" },
          "operationId": { "$ref": "#/definitions/OutboxOperationId" }
        }
      },
      "result": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entry"],
        "properties": { "entry": { "$ref": "#/definitions/OutboxEntry" } }
      }
    },
    {
      "kind": "Notification",
      "name": "litch/feishu/appsChanged",
      "params": {
        "type": "object",
        "additionalProperties": false,
        "properties": { "appId": { "$ref": "#/definitions/AppId" } }
      }
    },
    {
      "kind": "Notification",
      "name": "litch/feishu/registrationChanged",
      "params": {
        "type": "object",
        "additionalProperties": false,
        "required": ["registrationId", "revision"],
        "properties": {
          "registrationId": { "$ref": "#/definitions/LogicalId" },
          "revision": { "$ref": "#/definitions/Revision" }
        }
      }
    },
    {
      "kind": "Notification",
      "name": "litch/feishu/chatsChanged",
      "params": {
        "type": "object",
        "additionalProperties": false,
        "required": ["appId"],
        "properties": {
          "appId": { "$ref": "#/definitions/AppId" },
          "chatId": { "$ref": "#/definitions/ChatId" }
        }
      }
    },
    {
      "kind": "Notification",
      "name": "litch/feishu/inboxChanged",
      "params": {
        "type": "object",
        "additionalProperties": false,
        "required": ["managerId", "appId"],
        "properties": {
          "managerId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$" },
          "appId": { "$ref": "#/definitions/AppId" }
        }
      }
    },
    {
      "kind": "Method",
      "name": "litch/feishu/binding/list",
      "params": {
        "type": "object",
        "additionalProperties": false,
        "required": ["appId"],
        "properties": { "appId": { "$ref": "#/definitions/AppId" } }
      },
      "result": {
        "type": "object",
        "additionalProperties": false,
        "required": ["bindings"],
        "properties": {
          "bindings": { "type": "array", "items": { "$ref": "#/definitions/Binding" } }
        }
      }
    },
    {
      "kind": "Method",
      "name": "litch/feishu/binding/lookup",
      "params": { "$ref": "#/definitions/PairingCodeParams" },
      "result": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pairing"],
        "properties": { "pairing": { "$ref": "#/definitions/Pairing" } }
      }
    },
    {
      "kind": "Method",
      "name": "litch/feishu/binding/approve",
      "params": { "$ref": "#/definitions/PairingCodeParams" },
      "result": { "$ref": "#/definitions/BindingResult" }
    },
    {
      "kind": "Method",
      "name": "litch/feishu/binding/revoke",
      "params": {
        "type": "object",
        "additionalProperties": false,
        "required": ["appId", "openId", "expectedRevision"],
        "properties": {
          "appId": { "$ref": "#/definitions/AppId" },
          "openId": { "$ref": "#/definitions/OpenId" },
          "expectedRevision": { "$ref": "#/definitions/Revision" }
        }
      },
      "result": { "$ref": "#/definitions/BindingResult" }
    },
    {
      "kind": "Method",
      "name": "litch/feishu/binding/update",
      "params": {
        "type": "object",
        "additionalProperties": false,
        "required": ["appId", "openId", "expectedRevision"],
        "minProperties": 4,
        "properties": {
          "appId": { "$ref": "#/definitions/AppId" },
          "openId": { "$ref": "#/definitions/OpenId" },
          "expectedRevision": { "$ref": "#/definitions/Revision" },
          "approver": { "type": "boolean" },
          "retentionDays": { "$ref": "#/definitions/RetentionDays" }
        }
      },
      "result": { "$ref": "#/definitions/BindingResult" }
    },
    {
      "kind": "Notification",
      "name": "litch/feishu/outboxChanged",
      "params": {
        "type": "object",
        "additionalProperties": false,
        "required": ["appId", "operationId"],
        "properties": {
          "appId": { "$ref": "#/definitions/AppId" },
          "operationId": { "$ref": "#/definitions/OutboxOperationId" }
        }
      }
    },
    {
      "kind": "Notification",
      "name": "litch/feishu/bindingsChanged",
      "params": {
        "type": "object",
        "additionalProperties": false,
        "required": ["appId"],
        "properties": {
          "appId": { "$ref": "#/definitions/AppId" },
          "openId": { "$ref": "#/definitions/OpenId" }
        }
      }
    }
  ],
  "definitions": {
    "PairingCodeParams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["appId", "code"],
      "properties": {
        "appId": { "$ref": "#/definitions/AppId" },
        "code": { "type": "string", "pattern": "^[A-Za-z0-9]{4}[- ]?[A-Za-z0-9]{4}$" }
      }
    },
    "Pairing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["appId", "openId", "createdAt", "expiresAt"],
      "properties": {
        "appId": { "$ref": "#/definitions/AppId" },
        "openId": { "$ref": "#/definitions/OpenId" },
        "name": { "type": "string", "maxLength": 256 },
        "unionId": { "type": "string", "maxLength": 128 },
        "createdAt": { "$ref": "#/definitions/Timestamp" },
        "expiresAt": { "$ref": "#/definitions/Timestamp" }
      }
    },
    "Binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "appId",
        "openId",
        "revision",
        "name",
        "state",
        "approver",
        "retentionDays",
        "boundAt"
      ],
      "properties": {
        "appId": { "$ref": "#/definitions/AppId" },
        "openId": { "$ref": "#/definitions/OpenId" },
        "revision": { "$ref": "#/definitions/Revision" },
        "name": { "type": "string", "maxLength": 256 },
        "unionId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "state": { "enum": ["bound", "revoked"] },
        "approver": { "type": "boolean" },
        "retentionDays": { "$ref": "#/definitions/RetentionDays" },
        "boundAt": { "$ref": "#/definitions/Timestamp" },
        "revokedAt": { "$ref": "#/definitions/Timestamp" }
      }
    },
    "BindingResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding"],
      "properties": { "binding": { "$ref": "#/definitions/Binding" } }
    },
    "OutboxOperationId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{8,40}$" },
    "OutboxState": {
      "enum": [
        "awaiting_approval",
        "queued",
        "sending",
        "sent",
        "failed",
        "rejected",
        "canceled",
        "unknown"
      ]
    },
    "CliRequest": {
      "description": "经 lark-cli 发的原始请求（设备代理拦下转审批的发言）：方法、打码后的路径、动作",
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "path", "action"],
      "properties": {
        "method": { "enum": ["POST", "PUT", "PATCH", "DELETE"] },
        "path": { "type": "string", "maxLength": 1024 },
        "action": { "type": "string", "pattern": "^[a-z_]{1,32}$" }
      }
    },
    "OutboxEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operationId",
        "appId",
        "managerId",
        "target",
        "format",
        "summary",
        "parts",
        "messageIds",
        "mentions",
        "state",
        "attempts",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "operationId": { "$ref": "#/definitions/OutboxOperationId" },
        "appId": { "$ref": "#/definitions/AppId" },
        "managerId": { "type": "string", "maxLength": 128 },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id", "name"],
          "properties": {
            "kind": { "enum": ["chat", "user"] },
            "id": { "type": "string", "maxLength": 128 },
            "name": { "type": "string", "maxLength": 256 }
          }
        },
        "replyTo": { "type": "string", "maxLength": 128 },
        "format": { "enum": ["text", "post", "card", "image", "file"] },
        "summary": { "type": "string", "maxLength": 400 },
        "parts": { "type": "integer", "minimum": 1, "maximum": 100 },
        "messageIds": {
          "type": "array",
          "maxItems": 100,
          "items": { "type": "string", "maxLength": 128 }
        },
        "mentions": {
          "type": "array",
          "maxItems": 50,
          "items": { "$ref": "#/definitions/Person" }
        },
        "state": { "$ref": "#/definitions/OutboxState" },
        "reviewId": { "type": "string", "pattern": "^A-[1-9][0-9]{0,15}$" },
        "attempts": { "$ref": "#/definitions/Count" },
        "error": { "type": "string", "pattern": "^[a-z_]{1,64}$" },
        "createdAt": { "$ref": "#/definitions/Timestamp" },
        "updatedAt": { "$ref": "#/definitions/Timestamp" },
        "sentAt": { "$ref": "#/definitions/Timestamp" },
        "cli": { "$ref": "#/definitions/CliRequest" }
      }
    },
    "AppId": { "type": "string", "pattern": "^cli_[0-9a-f]{16}$" },
    "LogicalId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$" },
    "OperationId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "Revision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "Timestamp": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "Count": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "AppResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["app"],
      "properties": { "app": { "$ref": "#/definitions/App" } }
    },
    "RegistrationRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registrationId"],
      "properties": { "registrationId": { "$ref": "#/definitions/LogicalId" } }
    },
    "RegistrationResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registration"],
      "properties": { "registration": { "$ref": "#/definitions/Registration" } }
    },
    "App": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "appId",
        "revision",
        "name",
        "managerId",
        "enabled",
        "credential",
        "connection",
        "capability",
        "createdAt"
      ],
      "properties": {
        "appId": { "$ref": "#/definitions/AppId" },
        "revision": { "$ref": "#/definitions/Revision" },
        "name": { "type": "string", "maxLength": 256 },
        "botOpenId": { "type": "string", "maxLength": 128 },
        "avatar": { "type": "string", "maxLength": 2048 },
        "managerId": { "oneOf": [{ "$ref": "#/definitions/LogicalId" }, { "type": "null" }] },
        "enabled": { "type": "boolean" },
        "credential": {
          "type": "object",
          "additionalProperties": false,
          "required": ["generation", "updatedAt"],
          "properties": {
            "generation": { "$ref": "#/definitions/Revision" },
            "updatedAt": { "$ref": "#/definitions/Timestamp" }
          }
        },
        "connection": { "$ref": "#/definitions/Connection" },
        "capability": { "oneOf": [{ "$ref": "#/definitions/Capability" }, { "type": "null" }] },
        "creatorOpenId": { "type": "string", "maxLength": 128 },
        "createdAt": { "$ref": "#/definitions/Timestamp" },
        "pendingPairings": { "type": "integer", "minimum": 0, "maximum": 1000 }
      }
    },
    "Connection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "since", "reconnects"],
      "properties": {
        "state": { "enum": ["stopped", "connecting", "connected", "reconnecting", "failed"] },
        "since": { "$ref": "#/definitions/Timestamp" },
        "lastConnectedAt": { "$ref": "#/definitions/Timestamp" },
        "lastEventAt": { "$ref": "#/definitions/Timestamp" },
        "reconnects": { "$ref": "#/definitions/Count" },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "at"],
          "properties": {
            "code": {
              "enum": [
                "credential_rejected",
                "app_disabled",
                "network",
                "rate_limited",
                "platform",
                "connection_limit"
              ]
            },
            "at": { "$ref": "#/definitions/Timestamp" }
          }
        }
      }
    },
    "Capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkedAt", "state", "missingScopes", "missingEvents", "missingCallbacks"],
      "properties": {
        "checkedAt": { "$ref": "#/definitions/Timestamp" },
        "state": { "enum": ["ok", "missing", "needs_self_manage", "app_disabled", "unknown"] },
        "missingScopes": { "type": "array", "items": { "type": "string", "maxLength": 128 } },
        "missingEvents": { "type": "array", "items": { "type": "string", "maxLength": 128 } },
        "missingCallbacks": { "type": "array", "items": { "type": "string", "maxLength": 128 } },
        "publish": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "at"],
          "properties": {
            "state": { "enum": ["pending_review", "published", "unknown"] },
            "versionId": { "type": "string", "maxLength": 128 },
            "at": { "$ref": "#/definitions/Timestamp" }
          }
        }
      }
    },
    "Registration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registrationId", "revision", "state", "name", "expiresAt"],
      "properties": {
        "registrationId": { "$ref": "#/definitions/LogicalId" },
        "revision": { "$ref": "#/definitions/Revision" },
        "state": { "enum": ["waiting", "succeeded", "denied", "expired", "canceled", "error"] },
        "name": { "type": "string", "maxLength": 30 },
        "url": { "type": "string", "pattern": "^https://(open|accounts)\\.feishu\\.cn/" },
        "expiresAt": { "$ref": "#/definitions/Timestamp" },
        "appId": { "$ref": "#/definitions/AppId" },
        "error": {
          "enum": ["lark_tenant", "unavailable", "credential_invalid", "already_configured"]
        }
      }
    },
    "ChatId": { "type": "string", "pattern": "^oc_[0-9A-Za-z_-]{1,64}$" },
    "OpenId": { "type": "string", "pattern": "^ou_[0-9A-Za-z_-]{1,64}$" },
    "SpeechMode": { "enum": ["free", "approval"] },
    "RetentionDays": { "type": "integer", "minimum": 1, "maximum": 3650 },
    "ReviewTtlHours": { "type": "integer", "minimum": 1, "maximum": 168 },
    "Wakers": {
      "type": "array",
      "maxItems": 200,
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/OpenId" }
    },
    "Person": {
      "type": "object",
      "additionalProperties": false,
      "required": ["openId", "name"],
      "properties": {
        "openId": { "$ref": "#/definitions/OpenId" },
        "name": { "type": "string", "maxLength": 256 }
      }
    },
    "ChatAccess": {
      "type": "object",
      "additionalProperties": false,
      "required": ["speech", "wakeBound", "wakers", "retentionDays", "reviewTtlHours", "accessAt"],
      "properties": {
        "speech": { "$ref": "#/definitions/SpeechMode" },
        "wakeBound": { "type": "boolean" },
        "wakers": { "type": "array", "maxItems": 200, "items": { "$ref": "#/definitions/Person" } },
        "retentionDays": { "$ref": "#/definitions/RetentionDays" },
        "reviewTtlHours": { "$ref": "#/definitions/ReviewTtlHours" },
        "accessAt": { "$ref": "#/definitions/Timestamp" }
      }
    },
    "Chat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "appId",
        "chatId",
        "revision",
        "name",
        "external",
        "status",
        "botPresent",
        "access",
        "updatedAt"
      ],
      "properties": {
        "appId": { "$ref": "#/definitions/AppId" },
        "chatId": { "$ref": "#/definitions/ChatId" },
        "revision": { "$ref": "#/definitions/Revision" },
        "name": { "type": "string", "maxLength": 256 },
        "avatar": { "type": "string", "maxLength": 2048 },
        "external": { "type": "boolean" },
        "status": { "enum": ["normal", "dissolved"] },
        "botPresent": { "type": "boolean" },
        "access": { "oneOf": [{ "$ref": "#/definitions/ChatAccess" }, { "type": "null" }] },
        "updatedAt": { "$ref": "#/definitions/Timestamp" },
        "records": { "$ref": "#/definitions/ChatRecords" }
      }
    },
    "InboxId": { "type": "string", "pattern": "^FI-[1-9][0-9]{0,15}$" },
    "InboxStatus": { "enum": ["queued", "notified", "processed"] },
    "InboxEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inboxId",
        "status",
        "appId",
        "managerId",
        "chatId",
        "chatKind",
        "messageId",
        "senderOpenId",
        "senderIdentity",
        "trigger",
        "createdAt",
        "receivedAt"
      ],
      "properties": {
        "inboxId": { "$ref": "#/definitions/InboxId" },
        "status": { "$ref": "#/definitions/InboxStatus" },
        "appId": { "$ref": "#/definitions/AppId" },
        "managerId": { "type": "string", "maxLength": 128 },
        "chatId": { "type": "string", "maxLength": 128 },
        "chatKind": { "enum": ["group", "p2p"] },
        "messageId": { "type": "string", "maxLength": 128 },
        "senderOpenId": { "type": "string", "maxLength": 128 },
        "senderName": { "type": "string", "maxLength": 256 },
        "senderIdentity": { "enum": ["bound", "member", "unknown"] },
        "trigger": { "enum": ["mention", "reply", "p2p"] },
        "createdAt": { "$ref": "#/definitions/Timestamp" },
        "receivedAt": { "$ref": "#/definitions/Timestamp" },
        "deliveryId": { "type": "string", "maxLength": 128 },
        "notifiedAt": { "$ref": "#/definitions/Timestamp" },
        "processedAt": { "$ref": "#/definitions/Timestamp" },
        "note": { "enum": ["rate_limited"] }
      }
    },
    "InboxMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chatName", "text", "msgType", "state", "purged"],
      "properties": {
        "chatName": { "type": "string", "maxLength": 256 },
        "text": { "oneOf": [{ "type": "string", "maxLength": 21000 }, { "type": "null" }] },
        "msgType": { "type": "string", "maxLength": 64 },
        "state": { "enum": ["normal", "recalled", "deleted"] },
        "purged": { "type": "boolean" }
      }
    },
    "ChatRecords": {
      "type": "object",
      "additionalProperties": false,
      "required": ["messages"],
      "properties": {
        "messages": { "$ref": "#/definitions/Count" },
        "oldestAt": { "$ref": "#/definitions/Timestamp" },
        "backfill": { "$ref": "#/definitions/Backfill" },
        "gap": { "$ref": "#/definitions/GapFill" }
      }
    },
    "Backfill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "state", "start", "end", "fetched", "truncated", "startedAt"],
      "properties": {
        "kind": { "enum": ["access", "manual"] },
        "state": { "enum": ["running", "done", "failed"] },
        "start": { "$ref": "#/definitions/Timestamp" },
        "end": { "$ref": "#/definitions/Timestamp" },
        "fetched": { "$ref": "#/definitions/Count" },
        "truncated": { "type": "boolean" },
        "startedAt": { "$ref": "#/definitions/Timestamp" },
        "finishedAt": { "$ref": "#/definitions/Timestamp" }
      }
    },
    "GapFill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["at", "start", "end", "fetched", "complete"],
      "properties": {
        "at": { "$ref": "#/definitions/Timestamp" },
        "start": { "$ref": "#/definitions/Timestamp" },
        "end": { "$ref": "#/definitions/Timestamp" },
        "fetched": { "$ref": "#/definitions/Count" },
        "complete": { "type": "boolean" }
      }
    },
    "Member": { "$ref": "#/definitions/Person" },
    "ChatRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["appId", "chatId"],
      "properties": {
        "appId": { "$ref": "#/definitions/AppId" },
        "chatId": { "$ref": "#/definitions/ChatId" }
      }
    },
    "ChatResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chat"],
      "properties": { "chat": { "$ref": "#/definitions/Chat" } }
    }
  }
}

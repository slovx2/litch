{
  "name": "@codex-harness-adapter/opencode",
  "version": "0.25.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "diff": "8.0.4",
    "jsonc-parser": "3.3.1",
    "ws": "8.22.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
